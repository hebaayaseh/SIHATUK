{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",
  "ConnectionStrings": {
    "SharedDb": "Server=localhost;Database=sehatak_shared;User=root;Password=;",
    "TenantDbTemplate": "Server=localhost;User=root;Password=;"
  },

